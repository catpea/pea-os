<?xml version="1.0" encoding="UTF-8"?>
<app version="1" id="json" category="develop" summary="Check, format and explore JSON" title="JSON Lens" sprite="json" tint="#ffd75e" width="320" height="220" min-width="220" min-height="160">
  <state>
    <signal name="source" value="{&#10;  &quot;name&quot;: &quot;Pea OS&quot;,&#10;  &quot;garden&quot;: &quot;peas&quot;,&#10;  &quot;apps&quot;: [&#10;    &quot;paint&quot;,&#10;    &quot;regex&quot;,&#10;    &quot;json&quot;&#10;  ],&#10;  &quot;pixels&quot;: {&#10;    &quot;fine&quot;: 1,&#10;    &quot;chunky&quot;: 6&#10;  },&#10;  &quot;offline&quot;: true,&#10;  &quot;server&quot;: null&#10;}"/>
    <signal name="indent" value="2"/>
    <signal name="filter" value=""/>
    <signal name="node" value=""/>
    <signal name="valid" type="boolean" value="false"/>
    <signal name="status" value=""/>
  </state>
  <view>
    <column padding="4" gap="3">
      <row gap="3" align="center" wrap="true">
        <button text="Format" action="format" kind="accent" enabled="{valid}"/>
        <button text="Minify" action="minify" enabled="{valid}"/>
        <button text="Sort keys" action="sort-keys" enabled="{valid}"/>
        <select value="{indent}" width="72" label="Indent">
          <option value="2" text="2 spaces"/>
          <option value="4" text="4 spaces"/>
          <option value="tab" text="Tabs"/>
        </select>
        <button text="To Notepad" action="to-notepad"/>
      </row>
      <split direction="horizontal" ratio="0.55" min="70" grow="1">
        <textarea id="editor" value="{source}" wrap="false" maxlength="200000" label="JSON text"/>
        <column gap="3">
          <field value="{filter}" placeholder="Filter paths" maxlength="200" label="Filter paths"/>
          <list id="outline" value="{node}" action="show-node" grow="1" empty="Nothing to show" label="Paths and values"/>
        </column>
      </split>
      <label text="{status}" color="dim"/>
    </column>
  </view>
</app>
