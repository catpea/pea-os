<?xml version="1.0" encoding="UTF-8"?>
<app version="1" id="paint" category="create" summary="Pixel pictures, PNG export" title="Pea Paint" sprite="paint" tint="#63d2f0" width="254" height="210" min-width="210" min-height="150">
  <state>
    <signal name="size" type="number" value="2"/>
    <signal name="tool" value="pencil"/>
    <signal name="dimensions" value="200 × 128"/>
    <signal name="file-name" value="Untitled"/>
    <signal name="file-status" value="Opening…"/>
    <signal name="can-undo" type="boolean" value="false"/>
    <signal name="can-redo" type="boolean" value="false"/>
  </state>
  <view>
    <scroll>
    <column id="body" padding="4" gap="3">
      <row wrap="true" gap="3" align="center">
        <button text="Save" action="file-save"/>
        <button text="Open" action="file-open"/>
        <button text="PNG" action="export-png" tooltip="Export a PNG image"/>
        <spacer/>
        <button text="Undo" action="undo" enabled="{can-undo}"/>
        <button text="Redo" action="redo" enabled="{can-redo}"/>
      </row>
      <row wrap="true" gap="4" align="center">
        <select value="{tool}" width="76">
          <option value="pencil" text="Pencil"/>
          <option value="erase" text="Eraser"/>
          <option value="fill" text="Fill"/>
          <option value="line" text="Line"/>
          <option value="rect" text="Rectangle"/>
          <option value="pick" text="Pick color"/>
        </select>
        <label text="Brush"/>
        <choice value="{size}">
          <option value="1" text="S"/>
          <option value="2" text="M"/>
          <option value="4" text="L"/>
        </choice>
        <spacer/>
        <button text="Clear" action="clear"/>
      </row>
      <panel kind="inset" padding="1" grow="1">
        <scroll id="viewport" grow="1" axis="both">
          <canvas id="paper" width="200" height="128"/>
        </scroll>
      </panel>
      <canvas id="swatches" height="13"/>
      <row wrap="true" gap="4" align="center">
        <label text="{file-status}" color="dim" grow="1"/>
        <button text="{dimensions}" action="resize-picture" tooltip="Change the picture size"/>
      </row>
    </column>
    </scroll>
  </view>
</app>
